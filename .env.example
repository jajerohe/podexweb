# Conexión a PostgreSQL de Supabase (la misma base de la versión en Streamlit).
# En Vercel use el "Transaction pooler" (puerto 6543) de Supabase → Connect.
DATABASE_URL=postgresql://postgres.<proyecto>:<contraseña>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Auth: solo se usa para validar el correo y la contraseña al iniciar sesión.
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<llave publishable/anon>

# Firma de la cookie de sesión de PODEX. Cualquier texto largo y aleatorio
# (por ejemplo: openssl rand -base64 32).
SESSION_SECRET=

# Escritura en la base de datos (Gestionar y Actualizar solicitud).
# Mientras se compara con la versión en Streamlit queda en solo lectura;
# ponga 1 para permitir guardar.
PODEX_ESCRITURA=0

# Nombre y descripción del sistema (opcionales).
NOMBRE_SISTEMA=Podex
DESCRIPCION_SISTEMA=Sistema Integrado de Gestión de Peticiones, Incidentes y Vulnerabilidades
